# Define minimum iOS platform version
platform :ios, '13.0'

# Released PushEngage iOS SDK 1.0.0. In 1.0.0 the SDK is split into the app pod
# `PushEngage` (which depends on `PushEngageExtension`) and the extension-safe
# `PushEngageExtension`. Both are published on CocoaPods trunk.

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Released PushEngage 1.0.0 from CocoaPods trunk, matching the version the
  # plugin's podspec declares. PushEngageExtension is pulled in transitively as
  # PushEngage's dependency.
  pod 'PushEngage', '1.0.0'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
#  target 'RunnerTests' do
#    inherit! :search_paths
#  end
end

# No build-setting overrides needed with PushEngage SDK 1.0.0: the extension
# targets link only the extension-safe `PushEngageExtension` pod, so the
# default APPLICATION_EXTENSION_API_ONLY handling works, and the SDK podspecs
# carry no arch exclusions or deployment-target quirks.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end

target 'NotificationServiceExtension' do
  use_frameworks!
  pod 'PushEngageExtension', '1.0.0'
end

target 'NotificationContentExtension' do
  use_frameworks!
  pod 'PushEngageExtension', '1.0.0'
end
